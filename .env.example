# Reilusoppari.fi – ympäristömuuttujat
# Kopioi tämä tiedosto nimellä .env.local ja täytä oikeat arvot.
# Tuotannossa samat arvot syötetään Vercelin Environment Variables -ruutuun.

# Julkaisutila: "soon" (OLETUS) | "waitlist" | "live". Ks. src/lib/launch.ts.
#   soon     = palvelu avautuu pian, odotuslistaa EI kerata. Ei lomaketta.
#   waitlist = odotuslistalomake nakyy. Vaatii Resend-asetukset alla.
#   live     = CTA ohjaa sovellukseen app.reilusoppari.fi.
# Oletus on `soon` tarkoituksella: ilman muuttujaa sivusto ei voi nayttaa
# lomaketta, joka ei toimi.
LAUNCH_MODE=soon

# Resend – vahvistussähköpostit ja odotuslistan segmentti.
# HUOM: Resendin SDK käyttää "segments"-mallia, ei enää "audienceId"-mallia
# (audienceId on deprecated) – ks. DECISIONS.md. CLAUDE.md kohta 9.3 puhuu
# "audiencesta", mutta luotava asia on segmentti nimeltä reilusoppari-waitlist.
RESEND_API_KEY=
RESEND_SEGMENT_ID=

# Lähettäjäosoite. Oletuksena Resendin testidomain (onboarding@resend.dev)
# kunnes reilusoppari.fi on vahvistettu Resendissä. Aseta sen jälkeen esim.
# "Reilusoppari <noreply@reilusoppari.fi>" – ei vaadi koodimuutosta.
EMAIL_FROM=

# Yhteydenottojen vastaanottajaosoite. Voi olla mikä tahansa sähköposti
# (ei tarvitse olla @reilusoppari.fi-osoite, eikä siis vaadi MX-tietueita
# domainille) – lomake lähettää sille Resendin kautta.
REILUSOPPARI_CONTACT_EMAIL=

# Yhteydenottolomakkeen testitila: "mock" = viesti hyväksytään mutta ei lähetetä.
# Testitila on päällä myös ilman RESEND_API_KEY:tä, paitsi Vercelin tuotannossa.
# Ei asetettava tuotantoon.
CONTACT_DELIVERY=

# Cloudflare Turnstile – bottisuoja lomakkeille.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Plausible-analytiikka (EU-hostattu, ei evästeitä). Jos tyhjä, skriptiä ei ladata.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=reilusoppari.fi

# Itse sovellus (eri Vercel-projekti), johon CTA ohjaa live-tilassa.
# Sovellus ajaa eSinetin moottorilla omalla brändillä.
NEXT_PUBLIC_APP_URL=https://app.reilusoppari.fi

# HMAC-salaisuus odotuslistan vahvistuslinkin allekirjoitukseen.
# Generoi esim.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WAITLIST_TOKEN_SECRET=

# Tämän sivuston oma julkinen osoite (vahvistuslinkkien ja skeemojen rakentamiseen).
# EI sama kuin NEXT_PUBLIC_APP_URL, joka osoittaa sovellukseen.
NEXT_PUBLIC_SITE_URL=https://www.reilusoppari.fi

# Chat-assistentti (Jukka 26.10.2026). Ilman avainta chat on kokonaan pois päältä:
# sivustolla ei näy chat-painiketta, ja /api/chat vastaa 503. Avain luetaan vain
# palvelimella. Käytä Anthropicin konsolissa omaa työtilaa "reilusoppari-web"
# kuukausirajalla, ei organisaation admin-avainta (BLOCKERS.md, kohta Chatbot).
ANTHROPIC_API_KEY=
# Valinnaiset: malli (oletus claude-sonnet-5-5), päiväbudjetti dollareina
# (oletus 5; muistissa, instanssikohtainen, kovakatto on konsolin kuukausiraja),
# pyyntöraja per IP minuutissa (6) ja tunnissa (30).
CHAT_MODEL=claude-sonnet-5-5
CHAT_DAILY_BUDGET_USD=5
CHAT_RATE_LIMIT_PER_MINUTE=6
CHAT_RATE_LIMIT_PER_HOUR=30
